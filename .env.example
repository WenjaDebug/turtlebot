# turtlebot configuration -------------------------------------------------------------
# Copy to .env and adjust. Every value shown here is the default; delete what you don't change.
# Nested groups use a double underscore: TURTLE_<GROUP>__<FIELD>.
# .env is git-ignored. Never commit real values.

# Master switch. While false, `turtlebot run` only works with --dry-run.
# Set to true only after you have deliberately approved a (re)start of live paper trading.
TURTLE_TRADING_ENABLED=false

# --- Broker (TWS / IB Gateway, paper only) --------------------------------------------
TURTLE_BROKER__HOST=127.0.0.1
TURTLE_BROKER__PORT=7497                 # paper port; anything else is rejected
TURTLE_BROKER__CLIENT_ID=11              # live bot; dry runs use 21-29
TURTLE_BROKER__PAPER_ACCOUNT_PREFIX=D    # IBKR paper accounts start with "D"
TURTLE_BROKER__CONNECT_TIMEOUT_S=20
TURTLE_BROKER__RECONNECT_INITIAL_DELAY_S=5
TURTLE_BROKER__RECONNECT_MAX_DELAY_S=300
TURTLE_BROKER__DISCONNECT_ALERT_AFTER_MIN=5

# --- Strategy (identical for both blocks) ---------------------------------------------
TURTLE_STRATEGY__ENTRY_PERIOD=20
TURTLE_STRATEGY__EXIT_PERIOD=10
TURTLE_STRATEGY__VOLUME_PERIOD=20
TURTLE_STRATEGY__VOLUME_FACTOR=1.5
TURTLE_STRATEGY__RANK_BY=breakout_strength

# --- Blocks (independent slot pools) ----------------------------------------------------
TURTLE_BLOCK1__ENABLED=true
TURTLE_BLOCK1__MAX_POSITIONS=20
TURTLE_BLOCK2__ENABLED=true              # legacy: TURTLE_BLOCK2=0
TURTLE_BLOCK2__MAX_POSITIONS=20
TURTLE_BLOCK2__MIN_STRENGTH=0.10

# --- Risk & universe ------------------------------------------------------------------
TURTLE_RISK__POSITION_PCT=0.015
TURTLE_RISK__MIN_CUSHION=0.25
TURTLE_RISK__MAX_NEW_ENTRIES_PER_DAY=10  # legacy: TURTLE_MAX_ENTRIES_PER_DAY
TURTLE_RISK__DAILY_LOSS_LIMIT_PCT=0.02
TURTLE_RISK__MIN_MARKET_CAP=500000000
TURTLE_RISK__MIN_DOLLAR_VOLUME=5000000
TURTLE_RISK__MIN_PRICE=1.0

# --- Schedule (exchange time) ---------------------------------------------------------
TURTLE_SCHEDULE__UNIVERSE_TIME=08:00
TURTLE_SCHEDULE__RECONCILE_TIME=09:00
TURTLE_SCHEDULE__SCAN_TIMES=["15:45"]
TURTLE_SCHEDULE__SCAN_GRACE_MIN=360

# --- Reconciliation safety ---------------------------------------------------------------
TURTLE_RECONCILIATION__CLOSE_CONFIRMATION_CYCLES=2
TURTLE_RECONCILIATION__MASS_DISAPPEARANCE_FRACTION=0.25
TURTLE_RECONCILIATION__ORPHAN_CONFIRMATION_CYCLES=2

# --- Paths --------------------------------------------------------------------------------
TURTLE_PATHS__DATA_DIR=var               # SQLite state, logs, lock files
TURTLE_PATHS__CACHE_DIR=.cache           # market data cache

# --- Dashboard ----------------------------------------------------------------------------
TURTLE_DASHBOARD__HOST=127.0.0.1
TURTLE_DASHBOARD__PORT=8000
TURTLE_DASHBOARD__CHAT_ENABLED=true      # uses the local `claude` CLI (Claude Code)

# --- Logging ------------------------------------------------------------------------------
TURTLE_LOG__LEVEL=INFO

# --- Secrets (optional) --------------------------------------------------------------------
# Not needed for the default chat backend. Leave empty unless you add an API-based backend.
# TURTLE_ANTHROPIC_API_KEY=
